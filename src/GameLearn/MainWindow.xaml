<Window x:Class="GameLearn.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameLearn"
        Title="GameLearn · 把单词留在故事里" Style="{StaticResource {x:Type Window}}" Width="1440" Height="960" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen">
  <Grid Margin="30,22,30,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <StackPanel Orientation="Horizontal">
        <Border Background="{StaticResource AccentBrush}" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0"><TextBlock Text="GL" Foreground="#13271C" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel><TextBlock Text="GameLearn" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="把单词留在故事里  /  WORDS WITH A WORLD" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <Button Content="悬浮栏" Click="Floating_Click" Margin="0,0,16,0" ToolTip="收起主窗口，使用置顶悬浮栏"/>
        <Border Background="#203B30" CornerRadius="14" Padding="14,7" Margin="0,0,12,0"><TextBlock Text="{Binding EngineLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12"/></Border>
        <TextBlock Text="{Binding WordCount}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18">
      <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding SelectedSource.Title, TargetNullValue=请选择画面来源}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedSource.SelectionHint}"/>
        <Button Grid.Column="1" Content="更换来源" Click="ChooseSource_Click" Margin="8,0,12,0"/>
        <TextBox Grid.Column="2" Text="{Binding GameName, UpdateSourceTrigger=LostFocus}" ToolTip="游戏名称，用于分类场景"/>
        <Button Grid.Column="3" Content="预览" Click="Preview_Click" Margin="12,0,8,0"/>
        <Button Grid.Column="4" Content="识别当前画面" Style="{StaticResource Primary}" Click="Recognize_Click"/>
        <CheckBox Grid.Column="5" Content="自动识别" IsChecked="{Binding IsAutomatic}" Margin="20,0,6,0" ToolTip="关闭后仍可使用快捷键识别"/>
      </Grid>
      <TextBlock Text="{Binding HotkeyWarning}" Visibility="{Binding HasHotkeyIssues, Converter={StaticResource BoolVisibility}}" Foreground="#E9BC82" FontSize="12" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="2" x:Name="Tabs">
      <TabItem Header="01  当前画面">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="355"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14"><TextBlock Text="游戏现场" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding LiveRefreshHint}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
                <Border Grid.Row="1" Background="#090F14" CornerRadius="9" ClipToBounds="True">
                  <Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="每一个生词，都有它的场景。" FontSize="19" Foreground="#8BA5B3" HorizontalAlignment="Center"/><TextBlock Text="选好来源，点击「识别当前画面」开始" Style="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center"/></StackPanel><local:SceneViewer x:Name="LiveScene" Source="{Binding Preview}"/></Grid>
                </Border>
                <DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="框选区域" Click="Crop_Click" Padding="12,6"/><Button Content="恢复全窗口" Click="ClearCrop_Click" Padding="12,6" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding RegionLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
              </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,15,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="识别出的原句" Style="{StaticResource Muted}" Margin="0,0,0,8"/><ListBox Grid.Row="1" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" FontSize="14"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="点词查看释义 · 自动保存场景" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding LineWords}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Click="Word_Click" Margin="0,0,6,6" Padding="11,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  <DockPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="修正并查词" DockPanel.Dock="Right" Click="Correct_Click" Padding="10,6" Margin="8,0,0,0"/><TextBox x:Name="Correction" ToolTip="输入被识别错的英文单词" Padding="8,5"/></DockPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><local:WordDetailView/></Border>
        </Grid>
      </TabItem>
      <TabItem Header="02  单词本">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="你的游戏词汇" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBox Grid.Row="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索英文或中文释义" Margin="0,0,0,10"/>
            <ComboBox Grid.Row="2" ItemsSource="{Binding Games}" SelectedItem="{Binding GameFilter}" Margin="0,0,0,14"/>
            <ListBox Grid.Row="3" ItemsSource="{Binding Words}" SelectedItem="{Binding SelectedWord}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Word}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding LastGame}" Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Text="{Binding Encounters, StringFormat=遇见 {0} 次}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <TextBlock Grid.Row="4" Text="只收藏查过的词，让每次学习都有来处。" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
          </Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><local:WordDetailView/></Border>
        </Grid>
      </TabItem>
      <TabItem Header="03  设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock Text="OBS 纯游戏画面" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="直接选择 OBS 的捕获源或当前输出。无需投影窗口，OBS 最小化也能识别。" Style="{StaticResource Muted}"/>
              <CheckBox x:Name="ObsLocalConfigBox" Content="读取本机 OBS 的连接配置（推荐）" Margin="0,14,0,10"/>
              <TextBlock Text="手动连接端口 / 仅本机" Style="{StaticResource Muted}"/><TextBox x:Name="ObsPortBox" Margin="0,6,0,12"/>
              <TextBlock Text="手动连接密码" Style="{StaticResource Muted}"/><PasswordBox x:Name="ObsPasswordBox" Margin="0,6,0,12"/>
              <Button Content="保存并连接 OBS" Click="SaveConnectObs_Click" HorizontalAlignment="Left"/>
              <TextBlock Text="{Binding ObsStatus}" Foreground="#A8E7BF" Margin="0,12,0,0"/>
              <TextBlock Text="首次连接需在 OBS → Tools → WebSocket Server Settings 开启服务器。默认使用本机现有密码，不改动 OBS 场景或录像状态。" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock Text="文字识别" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="识别引擎" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
              <ComboBox x:Name="EngineBox"><ComboBoxItem Content="本地 PP-OCRv5 · 完全离线"/><ComboBoxItem Content="官方 PP-OCRv6 API · 在线"/></ComboBox>
              <CheckBox x:Name="TextRegionBox" Content="本地自动识别优先处理文字区域" Margin="0,12,0,0"/>
              <TextBlock Text="自动识别复用未变化的文字区域，约每 3 秒重新完整扫描；即时识别始终扫描所选区域。可关闭以优先发现新位置的文字。" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
              <TextBlock Text="AI Studio Access Token" Style="{StaticResource Muted}" Margin="0,16,0,6"/><PasswordBox x:Name="OcrTokenBox"/>
              <TextBlock Text="在线 OCR 会上传所选游戏窗口或框选区域。它和下方的 AI 语境解释是独立服务。" Style="{StaticResource Muted}" Margin="0,10,0,16"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="本地间隔 / 秒" Style="{StaticResource Muted}"/><TextBox x:Name="LocalIntervalBox" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="在线间隔 / 秒" Style="{StaticResource Muted}"/><TextBox x:Name="CloudIntervalBox" Margin="0,6,0,0"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="在线超时 / 秒" Style="{StaticResource Muted}"/><TextBox x:Name="TimeoutBox" Margin="0,6,0,0"/></StackPanel>
              </Grid>
              <Button Content="保存并用当前区域测试官方 API" Click="TestCloud_Click" Margin="0,16,0,0" HorizontalAlignment="Left"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="全局快捷键" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="{Binding HotkeyStatus}" Foreground="#A8E7BF" Margin="0,0,0,14"/>
              <TextBlock Text="即时截图识别" Style="{StaticResource Muted}"/><TextBox x:Name="CaptureKeyBox" Margin="0,6,0,12"/>
              <TextBlock Text="开关自动识别" Style="{StaticResource Muted}"/><TextBox x:Name="AutoKeyBox" Margin="0,6,0,12"/>
              <TextBlock Text="展开上次遇见" Style="{StaticResource Muted}"/><TextBox x:Name="RecallKeyBox" Margin="0,6,0,0"/>
              <TextBlock Text="格式如 Ctrl+Alt+E。自动识别关闭时，即时识别快捷键仍然有效。" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock Text="AI 语境解释  /  可选" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="AI 服务地址（HTTP / HTTPS）" Style="{StaticResource Muted}"/><TextBox x:Name="AiUrlBox" Margin="0,6,0,6" ToolTip="可填写主机和端口、/v1 基础地址或完整的 /chat/completions 地址"/>
              <TextBlock Text="只填主机和端口时，自动补上 /v1/chat/completions；也支持完整接口地址。" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
              <TextBlock Text="模型名称" Style="{StaticResource Muted}"/><TextBox x:Name="AiModelBox" Margin="0,6,0,12"/>
              <TextBlock Text="API Key" Style="{StaticResource Muted}"/><PasswordBox x:Name="AiTokenBox" Margin="0,6,0,0"/>
              <TextBlock Text="点击「解释当前语境」才发送单词和原句，不发送截图。无需配置也能使用离线英汉词典。" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
              <WrapPanel Margin="0,16,0,0"><Button x:Name="SaveAiButton" Content="保存 AI 配置" Click="SaveAi_Click" Margin="0,0,8,8"/><Button Content="保存并测试 AI" Click="TestAi_Click" IsEnabled="{Binding CanTestAi}" Style="{StaticResource Primary}" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock Text="{Binding AiConfigurationStatus}" Foreground="#A8E7BF" Margin="0,6,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="数据与场景" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="单词、截图和学习历史保存在当前电脑。密钥使用 Windows 用户加密保护。" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
              <WrapPanel><Button Content="打开数据目录" Click="OpenData_Click" Margin="0,0,8,8"/><Button Content="清理未引用截图" Click="Cleanup_Click" Margin="0,0,0,8"/></WrapPanel>
              <Button Content="清空学习记录…" Click="ClearRecords_Click" Foreground="#F0B4AD" HorizontalAlignment="Left" Margin="0,4,0,16"/>
              <TextBlock Text="游戏中的浮层优先支持窗口化和无边框模式；独占全屏可使用 OBS 投影。关闭窗口会退出，最小化可继续后台运行。" Style="{StaticResource Muted}"/>
            </StackPanel></Border>
            <Button Content="保存全部设置" Style="{StaticResource Primary}" Click="SaveSettings_Click" HorizontalAlignment="Left" Padding="24,12" Margin="0,20,0,0"/>
          </StackPanel>
        </Grid></ScrollViewer>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="2,16,2,0"><TextBlock Text="GAMELEARN  /  01" DockPanel.Dock="Right" Foreground="#5F7C8A" FontSize="11"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/></DockPanel>
  </Grid>
</Window>
