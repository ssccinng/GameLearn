<Window x:Class="GameLearn.FloatingToolbar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameLearn 悬浮栏" Width="680" Height="460" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Foreground="#EAF3F0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,8"/><Setter Property="Margin" Value="3,0"/><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="#23373F"/></Style>
    <Style x:Key="AutomaticSwitch" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="Margin" Value="3,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Shell" Background="#23373F" CornerRadius="8" Padding="8"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="Lamp" Width="6" Height="6" Fill="#788E96" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock x:Name="Label" Text="自动" Foreground="#DCE9EA"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="#2A4D3D"/><Setter TargetName="Lamp" Property="Fill" Value="#A8E7BF"/><Setter TargetName="Label" Property="Foreground" Value="#BCEECE"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="Surface" Margin="5" CornerRadius="17" Background="#F514222B" BorderBrush="#496259" BorderThickness="1" Padding="9">
    <Grid>
      <Grid x:Name="ExpandedContent">
        <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="68"/><ColumnDefinition Width="54"/><ColumnDefinition Width="62"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
        <Thumb x:Name="DragHandle" Grid.RowSpan="2" Focusable="False" Cursor="SizeAll" ToolTip="拖动悬浮栏" DragStarted="Drag_Started" DragDelta="Drag_Delta" DragCompleted="Drag_Completed"><Thumb.Template><ControlTemplate><TextBlock Text="⠿" Foreground="#819D96" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Thumb.Template></Thumb>
        <Border Grid.Column="1" Background="#A8E7BF" CornerRadius="10" Height="31" Width="31" VerticalAlignment="Center"><TextBlock Text="GL" FontSize="13" FontWeight="Bold" Foreground="#143423" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Grid.Column="2" Text="GameLearn" FontWeight="SemiBold" FontSize="14" Margin="9,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
        <Button x:Name="CaptureButton" Grid.Column="3" Content="识别" Style="{StaticResource ToolButton}" Background="#A8E7BF" Foreground="#153325" FontWeight="SemiBold" Click="Capture_Click" ToolTip="识别当前游戏画面"/>
        <ToggleButton x:Name="AutomaticSwitch" Grid.Column="4" Style="{StaticResource AutomaticSwitch}" IsChecked="{Binding IsAutomatic, Mode=TwoWay}" Click="Automatic_Click" ToolTip="开启或关闭自动识别"/>
        <Button x:Name="RecallButton" Grid.Column="5" Content="回忆" Style="{StaticResource ToolButton}" Click="Recall_Click" ToolTip="查看上次遇见的场景"/>
        <Button x:Name="ExpandButton" Grid.Column="6" Content="展开" Style="{StaticResource ToolButton}" Click="Expand_Click" ToolTip="打开主界面、单词本与设置"/>
        <Button x:Name="CollapseButton" Grid.Column="7" Content="‹" Style="{StaticResource ToolButton}" FontSize="20" Padding="0" Click="Collapse_Click" ToolTip="收起成小按钮"/>
        <Button x:Name="HideButton" Grid.Column="8" Content="×" Style="{StaticResource ToolButton}" FontSize="17" Padding="0" Click="Hide_Click" ToolTip="隐藏悬浮栏，可从系统托盘恢复"/>
        <TextBlock x:Name="Caption" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="8" ToolTip="{Binding Status}" Foreground="#90AAA5" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="3,3,2,0"><Run Text="{Binding SelectedSource.Title}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock>
        <DockPanel Grid.Row="2" Grid.ColumnSpan="9" Margin="8,13,8,9">
          <TextBlock Text="画面单词" FontWeight="SemiBold" Foreground="#B8E5CA"/>
          <TextBlock x:Name="SceneStamp" FontSize="11" Foreground="#829E98" Margin="10,2,0,0"/>
          <TextBlock FontSize="11" HorizontalAlignment="Right" Margin="6,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="点单词查看释义"/><Setter Property="Foreground" Value="#90AAA5"/><Style.Triggers><DataTrigger Binding="{Binding IsAutomaticRefreshPaused}" Value="True"><Setter Property="Text" Value="操作中 · 内容已固定"/><Setter Property="Foreground" Value="#B8E5CA"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </DockPanel>
        <Grid Grid.Row="3" Grid.ColumnSpan="9" Margin="5,0,2,3">
          <ScrollViewer x:Name="WordsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="CurrentWordLines">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{Binding CardBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,4,8">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,7">
                      <Border DockPanel.Dock="Right" Background="#2B4948" CornerRadius="5" Padding="6,2"><TextBlock Text="{Binding PriorityLabel}" FontSize="10" Foreground="#C4E9D1"/></Border>
                      <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#B9D2CB" TextTrimming="CharacterEllipsis" MaxWidth="530"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Words}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Tag="{Binding DataContext.Line, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Click="Word_Click" Focusable="False" Background="#2C4949" Foreground="#ECF7F0" Padding="10,6" Margin="0,0,6,5" ToolTip="查看释义并记录这个场景">
                          <TextBlock Text="{Binding}" FontSize="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="540"/>
                        </Button>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border x:Name="EmptyWords" Background="#172830" CornerRadius="10" Padding="24" Margin="0,0,4,8">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="把画面里的英文，变成可以点的单词" FontSize="16" Foreground="#B8D2C5"/><TextBlock x:Name="EmptyWordsHint" Text="点击「识别」，或开启「自动」持续读取游戏画面。" Foreground="#8FAAA6" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid x:Name="CollapsedContent" Visibility="Collapsed">
        <Thumb x:Name="CompactDragHandle" Focusable="False" Cursor="SizeAll" ToolTip="单击展开，拖动调整位置" DragStarted="Drag_Started" DragDelta="Drag_Delta" DragCompleted="Drag_Completed"><Thumb.Template><ControlTemplate><Border Background="#223B32" CornerRadius="12"><TextBlock Text="GL" Foreground="#B4EFCA" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb>
      </Grid>
    </Grid>
  </Border>
</Window>
