<UserControl x:Class="GameLearn.WordDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameLearn">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
    <TextBlock Text="单词 · 场景 · 记忆" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
    <TextBlock Text="{Binding DetailWord}" FontFamily="Georgia, Microsoft YaHei UI" FontSize="32" Foreground="{StaticResource AccentBrush}"/>
    <TextBlock Text="{Binding DetailPhonetic}" Style="{StaticResource Muted}" Margin="0,8,0,14"/>
    <TextBlock Text="{Binding DetailTranslation}" FontSize="15" LineHeight="24"/>
    <Border Background="#0E1B22" CornerRadius="10" Padding="14" Margin="0,18,0,12"><TextBlock Text="{Binding DetailSentence}" Foreground="#BCD1DB" FontStyle="Italic" LineHeight="22"/></Border>
    <Button Content="解释当前语境" Click="Explain_Click" HorizontalAlignment="Left"/>
    <TextBlock Text="{Binding AiExplanation}" Margin="0,12,0,0" LineHeight="23" Foreground="#D0E2D5"/>
    <CheckBox Content="这个词已经掌握，不再提醒" IsChecked="{Binding Mastered}" Margin="0,16,0,10"/>
    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" MaxHeight="120" TextWrapping="Wrap" ToolTip="添加自己的记忆提示"/>
    <WrapPanel Margin="0,10,0,20"><Button Content="保存状态与备注" Click="Save_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="删除词条" Click="Delete_Click" Padding="12,7" Foreground="#F0B4AD"/></WrapPanel>
    <TextBlock Text="遇见的时间线 · 最新在前" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedEncounter}" MaxHeight="170"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding At, StringFormat={}{0:MM/dd HH:mm:ss}}" Foreground="#A8E7BF" FontSize="12"/><TextBlock Text="{Binding Game}" Margin="0,4,0,0"/><TextBlock Text="{Binding Sentence}" Style="{StaticResource Muted}" MaxHeight="36"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Background="#091116" CornerRadius="9" Margin="0,10,0,0" Height="190" ClipToBounds="True" MouseLeftButtonUp="EnlargeScene_Click" Cursor="Hand" ToolTip="点击放大当时的场景"><local:SceneViewer Source="{Binding HistoryImage}" HighlightBounds="{Binding SelectedEncounter.Bounds}"/></Border>
    <TextBlock Text="选择记录回忆当时的场景，点击截图可放大。" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer>
</UserControl>
