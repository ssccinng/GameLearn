<UserControl x:Class="GameLearn.WordDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameLearn">
  <ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel Margin="0,0,8,0">
    <Border Background="#203B30" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="正在学习" Foreground="#A8E7BF" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding DetailWord}" FontFamily="Georgia, Microsoft YaHei UI" FontSize="31" Foreground="#F0FAF1" Margin="0,3,0,0"/><TextBlock Text="{Binding DetailLemma}" Foreground="#B8D2C5" FontSize="11" Margin="0,3,0,0"/></StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding DetailPhonetic}" Foreground="#C0DACA" FontSize="13" VerticalAlignment="Center" Margin="12,12,0,0"/>
      </Grid>
    </Border>
    <TextBlock Text="中文释义" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="2,0,0,6"/>
    <TextBlock Text="{Binding DetailTranslation}" FontSize="15" LineHeight="24" Margin="2,0,0,2"/>
    <Border Background="#172830" BorderBrush="#2D4A4D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,12">
      <StackPanel><TextBlock Text="在游戏里遇到的句子" Foreground="#A8E7BF" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding DetailSentence}" Foreground="#D7E3E4" FontStyle="Italic" LineHeight="22" Margin="0,7,0,0"/></StackPanel>
    </Border>
    <WrapPanel Margin="0,0,0,2"><Button Content="快速翻译句子" Click="Translate_Click" IsEnabled="{Binding CanTranslate}" Padding="12,7"/><TextBlock Text="{Binding TranslationStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel>
    <Border Background="#20323F" CornerRadius="9" Padding="12" Margin="0,10,0,0"><TextBlock Text="{Binding SentenceTranslation}" LineHeight="23" Foreground="#D0E2D5"/></Border>
    <WrapPanel Margin="0,0,0,2"><Button Content="解释当前语境" Click="Explain_Click" Padding="12,7"/><TextBlock Text="可选 AI · 不发送截图" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel>
    <Border Background="#20323F" CornerRadius="9" Padding="12" Margin="0,10,0,0"><TextBlock Text="{Binding AiExplanation}" LineHeight="23" Foreground="#D0E2D5"/></Border>
    <Separator Margin="0,18,0,14" Background="#2B424B"/>
    <TextBlock Text="我的记忆" FontWeight="SemiBold" FontSize="15"/>
    <TextBlock Text="{Binding SelectedWord.CountsLabel}" Foreground="#A8E7BF" FontSize="12" Margin="0,8,0,0" ToolTip="查词为主动查询次数；查看包含查词和从单词本打开，均从本版开始统计。遇见按场景去重。"/>
    <TextBlock Text="{Binding SelectedWord.DatesLabel}" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
    <TextBlock Text="{Binding SelectedWord.LastViewedLabel}" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
    <TextBlock Text="分类 · 可输入新分类名称" Style="{StaticResource Muted}" Margin="0,12,0,5"/>
    <TextBox Text="{Binding CategoryDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" ToolTip="输入分类，例如剧情、战斗、日常；留空为未分类。点击下方保存生效。"/>
    <CheckBox Content="这个词已经掌握，不再提醒" IsChecked="{Binding Mastered}" Margin="0,10,0,8"/>
    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" MaxHeight="120" TextWrapping="Wrap" ToolTip="添加自己的记忆提示"/>
    <WrapPanel Margin="0,10,0,18"><Button Content="保存修改" ToolTip="保存分类、掌握状态与备注" Click="Save_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="删除词条" Click="Delete_Click" Padding="12,7" Foreground="#F0B4AD"/></WrapPanel>
    <DockPanel Margin="0,0,0,8"><TextBlock Text="遇见记录" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="最新在前" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></DockPanel>
    <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedEncounter}" MaxHeight="190" ScrollViewer.VerticalScrollBarVisibility="Hidden"><ListBox.ItemTemplate><DataTemplate><Border Padding="3,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding At, StringFormat={}{0:MM/dd HH:mm:ss}}" Foreground="#A8E7BF" FontSize="12"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Game}"/><TextBlock Text="{Binding Sentence}" Style="{StaticResource Muted}" MaxHeight="36" Margin="0,3,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Background="#091116" CornerRadius="9" Margin="0,10,0,0" Height="190" ClipToBounds="True" MouseLeftButtonUp="EnlargeScene_Click" Cursor="Hand" ToolTip="点击放大当时的场景"><local:SceneViewer Source="{Binding HistoryImage}" HighlightBounds="{Binding SelectedEncounter.Bounds}"/></Border>
    <TextBlock Text="选择记录回忆当时的场景，点击截图可放大。" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer>
</UserControl>
