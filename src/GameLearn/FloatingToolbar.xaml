<Window x:Class="GameLearn.FloatingToolbar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameLearn"
        Title="GameLearn 悬浮栏" Width="680" Height="460" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Foreground="#EAF3F0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="local:ToolbarMotion.Enabled" Value="True"/><Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#20343E"/><Setter Property="Foreground" Value="#DCEAE7"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid>
        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
        <Border x:Name="Highlight" CornerRadius="9" BorderBrush="#85BDA9" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ToolButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#A8C2BD"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="9,6"/></Style>
    <Style x:Key="ModeSwitch" TargetType="ToggleButton">
      <Setter Property="local:ToolbarMotion.Enabled" Value="True"/><Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#ADC4BE"/><Setter Property="Margin" Value="3,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Shell" Background="#1B2C34" CornerRadius="9" BorderBrush="#2D4348" BorderThickness="1" Padding="11,7"><StackPanel Orientation="Horizontal"><Ellipse x:Name="Lamp" Width="5" Height="5" Fill="#536D6B" Margin="0,0,7,0" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="#234638"/><Setter TargetName="Shell" Property="BorderBrush" Value="#4B8065"/><Setter TargetName="Lamp" Property="Fill" Value="#A8E7BF"/><Setter Property="Foreground" Value="#C4F0D3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#8DBCA8"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SentenceWord" TargetType="Button">
      <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#E4F1EC"/><Setter Property="Padding" Value="2,3"/><Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="WordSurface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="WordSurface" Property="Background" Value="#426557"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="Surface" Margin="5" CornerRadius="18" BorderBrush="#46645F" BorderThickness="1" Padding="12">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172D33" Offset="0"/><GradientStop Color="#101E28" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid>
      <Grid x:Name="ExpandedContent">
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="34"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
        <Thumb x:Name="DragHandle" Grid.RowSpan="2" Focusable="False" Cursor="SizeAll" ToolTip="拖动顶部空白区域移动悬浮栏" DragStarted="Drag_Started" DragDelta="Drag_Delta" DragCompleted="Drag_Completed"><Thumb.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></Thumb.Template></Thumb>
        <Grid IsHitTestVisible="False" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="#A8E7BF" CornerRadius="11" Width="33" Height="33" VerticalAlignment="Center"><TextBlock Text="GL" FontWeight="Bold" Foreground="#173B2A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="GameLearn" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="把单词留在故事里" Foreground="#73978F" FontSize="10" Margin="0,2,0,0"/></StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="CaptureButton" Content="识别" Style="{StaticResource ToolButton}" Background="#A8E7BF" Foreground="#153B29" FontWeight="SemiBold" Padding="18,9" Click="Capture_Click" ToolTip="识别当前游戏画面"/>
          <ToggleButton x:Name="AutomaticSwitch" Content="自动" Style="{StaticResource ModeSwitch}" IsChecked="{Binding IsAutomatic, Mode=TwoWay}" Click="Automatic_Click" ToolTip="开启或关闭自动识别"/>
          <ToggleButton x:Name="SelectionSwitch" Content="选词" Style="{StaticResource ModeSwitch}" Click="Selection_Click" ToolTip="在实时游戏画面上点选文字"/>
          <Button x:Name="CollapseButton" Content="‹" Style="{StaticResource QuietButton}" FontSize="21" Padding="8,1" Click="Collapse_Click" ToolTip="收起悬浮栏"/>
          <Button x:Name="HideButton" Content="×" Style="{StaticResource QuietButton}" FontSize="18" Padding="8,2" Click="Hide_Click" ToolTip="隐藏到托盘"/>
        </StackPanel>
        <TextBlock x:Name="Caption" Grid.Row="1" IsHitTestVisible="False" Text="{Binding Status}" ToolTip="{Binding Status}" Foreground="#8DA9A4" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="2,4,2,0"/>
        <Grid Grid.Row="2" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="SourceButton" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Click="Source_Click" ToolTip="更换游戏窗口或 OBS 来源" Margin="0,0,12,0"><TextBlock Text="{Binding SelectedSource.Title, StringFormat='来源 · {0}  ▾', TargetNullValue=选择画面来源  ▾, FallbackValue=选择画面来源  ▾}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="290"/></Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="WordbookButton" Content="词本" Style="{StaticResource QuietButton}" Click="Wordbook_Click"/><Button x:Name="RecentButton" Content="最近识别" Style="{StaticResource QuietButton}" Click="Recent_Click"/><Button x:Name="RecallButton" Content="回忆" Style="{StaticResource QuietButton}" Click="Recall_Click"/><Button x:Name="ExpandButton" Content="主界面" Style="{StaticResource QuietButton}" Click="Expand_Click"/></StackPanel>
        </Grid>
        <Grid Grid.Row="3">
          <ScrollViewer x:Name="WordsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="CurrentWordLines"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{Binding CardBrush}" CornerRadius="11" BorderBrush="#314D4B" BorderThickness="1" Padding="11,8" Margin="0,0,0,7"><StackPanel>
                <DockPanel><Button DockPanel.Dock="Right" Content="忽略 UI" Tag="{Binding Line}" Click="IgnoreLine_Click" Style="{StaticResource QuietButton}" FontSize="10" Padding="6,2" ToolTip="以后不再显示同类 UI 文字"/><TextBlock Text="{Binding PriorityLabel}" FontSize="10" Foreground="#A4CCB7" Margin="2,0,0,3"/></DockPanel>
                <ItemsControl ItemsSource="{Binding DisplayWords}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                  <Button Tag="{Binding DataContext.Line, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Click="Word_Click" Style="{StaticResource SentenceWord}" ToolTip="查看释义并记录场景"><TextBlock Text="{Binding}" FontSize="16" TextWrapping="Wrap" MaxWidth="565"/></Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
          <Border x:Name="EmptyWords" Background="#14262E" CornerRadius="12" BorderBrush="#284048" BorderThickness="1" Padding="26"><StackPanel VerticalAlignment="Center"><TextBlock Text="从一句对白，记住一个词。" FontSize="19" Foreground="#C2DDCF"/><TextBlock x:Name="EmptyWordsHint" Text="选择游戏画面，点击「识别」开始。" FontSize="12" Foreground="#88A69E" Margin="0,12,0,0"/></StackPanel></Border>
        </Grid>
        <DockPanel Grid.Row="4" Margin="2,6,2,0"><TextBlock x:Name="SceneStamp" FontSize="10" Foreground="#74958C"/><TextBlock FontSize="10" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="点词查释义 · 滚轮浏览"/><Setter Property="Foreground" Value="#74958C"/><Style.Triggers><DataTrigger Binding="{Binding IsAutomaticRefreshPaused}" Value="True"><Setter Property="Text" Value="操作中 · 内容已固定"/><Setter Property="Foreground" Value="#B8E5CA"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel>
      </Grid>
      <Grid x:Name="CollapsedContent" Visibility="Collapsed">
        <Thumb x:Name="CompactDragHandle" Focusable="False" Cursor="SizeAll" ToolTip="单击展开，拖动调整位置" DragStarted="Drag_Started" DragDelta="Drag_Delta" DragCompleted="Drag_Completed"><Thumb.Template><ControlTemplate><Border Background="#274D3B" CornerRadius="10"><TextBlock Text="GL" Foreground="#C7F5D6" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb>
      </Grid>
    </Grid>
  </Border>
</Window>
