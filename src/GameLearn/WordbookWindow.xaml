<Window x:Class="GameLearn.WordbookWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameLearn"
        Title="GameLearn · 单词与原句" Width="900" Height="720" MinWidth="420" MinHeight="400" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Foreground="#ECF3F5" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Border Background="#111E26" BorderBrush="#40565B" BorderThickness="1" CornerRadius="16" Padding="18">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Background="Transparent" MouseLeftButtonDown="Header_Drag" Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CompactButton" Content="紧凑悬浮" Click="Compact_Click" FontSize="12" Padding="10,7" Margin="0,0,6,0"/><Button x:Name="ToolbarButton" Content="悬浮栏" Click="Toolbar_Click" FontSize="12" Padding="10,7" Margin="0,0,6,0"/><Button x:Name="CloseButton" Content="×" Click="Close_Click" Padding="10,7"/></StackPanel>
        <TextBlock Text="单词与原句" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="搜索单词、实际词形、释义、备注、分类和原句"/><TextBlock Text="搜索单词、释义、备注或原句" Foreground="#718F88" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Column="1" Content="刷新" Click="Refresh_Click" Margin="8,0,0,0" Padding="12,7"/></Grid>
      <Expander x:Name="Filters" Grid.Row="2" Header="筛选与排序" Foreground="#B8D8C9" Margin="0,0,0,8">
        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="分类" Style="{StaticResource Muted}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="掌握状态" Style="{StaticResource Muted}" Margin="0,0,0,4"/><ComboBox x:Name="StatusBox" SelectedIndex="0" SelectionChanged="Status_Changed"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="未掌握"/><ComboBoxItem Content="已掌握"/></ComboBox></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,9,0,0"><TextBlock Text="排序" Style="{StaticResource Muted}" Margin="0,0,0,4"/><ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="Sort_Changed"><ComboBoxItem Content="最近遇见"/><ComboBoxItem Content="首次遇见（新到旧）"/><ComboBoxItem Content="查看次数最多"/><ComboBoxItem Content="查词次数最多"/><ComboBoxItem Content="遇见次数最多"/><ComboBoxItem Content="字母 A–Z"/><ComboBoxItem Content="最近查看"/></ComboBox></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,9,0,0"><TextBlock Text="首次遇见日期" Style="{StaticResource Muted}" Margin="0,0,0,4"/><ComboBox x:Name="DateBox" SelectedIndex="0" SelectionChanged="Date_Changed"><ComboBoxItem Content="全部日期"/><ComboBoxItem Content="今天"/><ComboBoxItem Content="最近 7 天"/><ComboBoxItem Content="最近 30 天"/><ComboBoxItem Content="自定义日期"/></ComboBox></StackPanel>
          <Grid x:Name="CustomDates" Grid.Row="2" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="起始日期 · yyyy-MM-dd" Style="{StaticResource Muted}" Margin="0,0,0,4"/><TextBox x:Name="FromDate" TextChanged="CustomDate_Changed" ToolTip="含当天；留空不限"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="截止日期 · yyyy-MM-dd" Style="{StaticResource Muted}" Margin="0,0,0,4"/><TextBox x:Name="ThroughDate" TextChanged="CustomDate_Changed" ToolTip="含当天；留空不限"/></StackPanel></Grid>
          <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,7,0,0"><Button Content="重置筛选" DockPanel.Dock="Right" Click="Reset_Click" Padding="10,5" FontSize="12"/><TextBlock x:Name="FilterHint" Text="日期按首次遇见筛选；分类在词条详情中编辑。" Foreground="#829F99" FontSize="11" VerticalAlignment="Center"/></DockPanel>
        </Grid>
      </Expander>
      <TabControl Grid.Row="3" x:Name="Pages" SelectionChanged="Page_Changed">
        <TabItem Header="单词本"><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="250"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding GameFilter}" Margin="0,0,10,10"/>
            <ListBox x:Name="SavedWords" Grid.Row="1" ItemsSource="{Binding Words}" SelectedItem="{Binding SelectedWord}" SelectionChanged="Word_Selected" PreviewMouseLeftButtonUp="Word_Clicked" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="0,0,10,0"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Word}" FontSize="20" FontWeight="SemiBold" Foreground="#C9EBD6"/><TextBlock Text="{Binding Translation}" Foreground="#94A9B8" FontSize="12" MaxHeight="32" LineHeight="16" TextTrimming="WordEllipsis" Margin="0,5,0,0"/><TextBlock Text="{Binding CategoryLabel}" Foreground="#A8E7BF" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="{Binding CountsLabel}" Foreground="#B3C9C2" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding DatesLabel}" Foreground="#94A9B8" FontSize="10" Margin="0,4,0,0"/><TextBlock Text="{Binding LastGame}" Foreground="#94A9B8" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
          <Border x:Name="WideDetail" Grid.Column="1" Background="#16232D" CornerRadius="12" Padding="16"><local:WordDetailView/></Border>
        </Grid></TabItem>
        <TabItem Header="最近识别"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="保留最近 200 次不同的识别内容；重复画面合并。" Foreground="#94A9B8" FontSize="12" Margin="0,0,0,10"/>
          <ListBox x:Name="RecentItems" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Hidden"><ListBox.ItemTemplate><DataTemplate><Border Background="#1C3038" CornerRadius="10" Padding="12"><StackPanel>
            <TextBlock Foreground="#A8E7BF" FontSize="12"><Run Text="{Binding At, StringFormat={}{0:MM/dd HH:mm:ss}}"/><Run Text="  ·  "/><Run Text="{Binding Game}"/></TextBlock>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" Margin="0,8,0,5"/>
            <ItemsControl ItemsSource="{Binding Words}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Word}" Tag="{Binding}" Click="RecentWord_Click" Padding="8,5" Margin="0,0,5,5" ToolTip="从这次历史识别中查词"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid></TabItem>
        <TabItem x:Name="CompactDetail" Header="释义" Visibility="Collapsed"><Border Background="#16232D" CornerRadius="12" Padding="12"><local:WordDetailView/></Border></TabItem>
      </TabControl>
      <TextBlock x:Name="Summary" Grid.Row="4" Foreground="#94A9B8" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
  </Border>
</Window>
